#!/usr/bin/env bun
/**
 * gstack-skill-lint — scan a SKILL.md body for prompt-injection / context-poisoning.
 *
 * The ToxicSkills class (Snyk, 2026): 36.8% of published skills carried a flaw,
 * and the defining attack is INSTRUCTION-BODY injection — the SKILL.md prose
 * itself carries adversarial directives that pass visual review and only
 * manifest at runtime. gstack installs skills from ClawHub and accepts
 * community PRs, so it is directly exposed; no other skill suite lints this.
 *
 * Two layers, both reused from the existing browser-security stack:
 *   1. Deterministic heuristics — exfil directives, instruction-injection
 *      phrasing, tool-permission escalation prose, invisible-unicode payloads.
 *      Always available, zero deps.
 *   2. The TestSavant ONNX classifier (scanPageContent) when the model cache
 *      is present. Runs under bun (NOT the compiled browse binary — onnxruntime
 *      can't dlopen from a Bun-compile temp dir; this bin is interpreted).
 * Verdicts are combined with the same combineVerdict ensemble the sidebar uses.
 *
 * The FRONTMATTER is skipped: `allowed-tools:` legitimately names tools, which
 * would false-positive as "permission escalation". Only the body is scanned.
 *
 * Usage: gstack-skill-lint <path-to-SKILL.md> [--json] [--no-ml]
 * Exit:  0 safe · 2 warn (review advised) · 3 block (do not install) · 5 usage
 */
import { readFileSync } from 'fs';

type Verdict = 'safe' | 'warn' | 'block';

const args = process.argv.slice(2);
const asJson = args.includes('--json');
const noMl = args.includes('--no-ml');
const file = args.find((a) => !a.startsWith('--'));
if (!file) {
  process.stderr.write('usage: gstack-skill-lint <SKILL.md> [--json] [--no-ml]\n');
  process.exit(5);
}

let raw: string;
try {
  raw = readFileSync(file, 'utf-8');
} catch (e) {
  process.stderr.write(`gstack-skill-lint: cannot read ${file}\n`);
  process.exit(5);
}

/** Strip a leading YAML frontmatter block — its tool declarations are legit. */
function bodyOf(text: string): string {
  const m = text.match(/^﻿?---\r?\n[\s\S]*?\r?\n---\r?\n/);
  return m ? text.slice(m[0].length) : text;
}

interface Hit { pattern: string; score: number; sample: string; }

const HEURISTICS: Array<{ id: string; re: RegExp; score: number }> = [
  // Exfiltration: "send/post/upload ... to <url>" near secrets/tokens/keys.
  { id: 'exfil-directive', score: 0.95,
    re: /\b(send|post|upload|exfiltrate|transmit|forward)\b[^.\n]{0,60}\b(token|secret|key|credential|password|\.env|cookie)s?\b[^.\n]{0,60}(https?:\/\/|to\s+\S+\.\S)/i },
  { id: 'exfil-endpoint', score: 0.9,
    re: /\b(curl|wget|fetch|Invoke-WebRequest)\b[^\n]{0,80}(-d|--data|-F|POST)[^\n]{0,80}(token|secret|key|\.env|cookie)/i },
  // Instruction-injection phrasing aimed at the reading agent.
  { id: 'ignore-instructions', score: 0.92,
    re: /\bignore\b[^.\n]{0,40}\b(previous|prior|above|earlier|all)\b[^.\n]{0,20}\b(instructions?|rules?|prompts?|directions?)\b/i },
  { id: 'override-system', score: 0.85,
    re: /\b(disregard|override|bypass|forget)\b[^.\n]{0,30}\b(system|safety|guard|policy|the user'?s?)\b[^.\n]{0,30}\b(prompt|instructions?|rules?|request)\b/i },
  // Solo score below the warn floor (0.6): "do not tell the user" is common
  // in legitimate operational docs. It only pushes to warn/block when it
  // STACKS with an exfil or escalation hit (handled in the severity calc).
  { id: 'hidden-mandate', score: 0.5,
    re: /\b(without (telling|informing|asking)|do not (tell|mention|inform|warn)|secretly|silently)\b[^.\n]{0,40}\b(the )?user\b/i },
  // Permission/scope escalation in prose (frontmatter already stripped).
  { id: 'escalate-tools', score: 0.75,
    re: /\b(also (run|execute|enable)|additionally (run|grant)|and then (run|execute))\b[^.\n]{0,50}\b(rm -rf|sudo|--dangerously|chmod \+x|Bash\(\*\)|allowed-tools)/i },
];

const body = bodyOf(raw);
const hits: Hit[] = [];
for (const h of HEURISTICS) {
  const m = body.match(h.re);
  if (m) hits.push({ pattern: h.id, score: h.score, sample: m[0].slice(0, 80) });
}

// Invisible-unicode payload check (tag chars, zero-width, bidi overrides —
// classic ways to hide instructions from a human reviewer).
const invisible = [...body].filter((c) => {
  const cp = c.codePointAt(0)!;
  return (cp >= 0xE0000 && cp <= 0xE007F) // Unicode tag block
    || cp === 0x200B || cp === 0x200C || cp === 0x200D || cp === 0xFEFF // zero-width
    || (cp >= 0x202A && cp <= 0x202E) || (cp >= 0x2066 && cp <= 0x2069); // bidi
}).length;
if (invisible > 0) hits.push({ pattern: 'invisible-unicode', score: 0.9, sample: `${invisible} hidden codepoint(s)` });

// Optional ML layer — the same ONNX classifier the sidebar uses, when warm.
// It STRENGTHENS the verdict (never weakens it): a high ML score with no
// heuristic hit still warns, and it can promote a heuristic warn to block.
let mlNote = 'skipped';
let mlScore = 0;
if (!noMl && process.env.GSTACK_SECURITY_OFF !== '1') {
  try {
    const { scanPageContent } = await import('../browse/src/security-classifier');
    const sig = await scanPageContent(body.slice(0, 8000));
    mlScore = sig.score;
    mlNote = `testsavant score ${sig.score.toFixed(2)}`;
  } catch (e: any) {
    mlNote = `unavailable (${String(e.message || e).slice(0, 60)})`;
  }
}

// Self-contained severity: the max heuristic score, raised if the ML
// classifier independently agrees. Content-only thresholds are intentionally
// firm — a 0.95 exfil directive is not a "maybe".
const maxHeuristic = hits.reduce((m, h) => Math.max(m, h.score), 0);
// A "weak" hint (hidden-mandate alone) stacks: two or more hits raise the
// floor to warn, because a hidden mandate beside any other flag is the shape
// of a real payload even when neither alone would trip.
const stacked = hits.length >= 2 ? Math.max(maxHeuristic, 0.65) : maxHeuristic;
const severity = mlScore >= 0.75 ? Math.max(stacked, 0.9) : stacked;
const verdict: Verdict = severity >= 0.9 ? 'block' : severity >= 0.6 ? 'warn' : 'safe';
const exit = verdict === 'block' ? 3 : verdict === 'warn' ? 2 : 0;

if (asJson) {
  console.log(JSON.stringify({ file, verdict, exit, hits, ml: mlNote }, null, 2));
} else {
  console.log(`gstack-skill-lint: ${file}`);
  console.log(`  verdict: ${verdict.toUpperCase()}   (ML: ${mlNote})`);
  if (hits.length === 0) console.log('  no injection heuristics matched');
  for (const h of hits) console.log(`  [${h.score.toFixed(2)}] ${h.pattern}: ${h.sample}`);
  if (exit === 3) console.log('  → DO NOT INSTALL. The skill body contains runtime-active adversarial directives.');
  else if (exit === 2) console.log('  → REVIEW before installing. Flagged content may be legitimate documentation.');
}
process.exit(exit);

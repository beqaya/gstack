#!/usr/bin/env python3
"""gstack-pipeline — which stages a work item of a given kind runs, in order.

Sub-project B is ROUTING, not authorship. The gstack suite already contains the
skills that do the work; this table only says which sequence a kind of item runs
and what comes next. Adding a kind is adding a row.

It is a plain table on purpose, exactly like gstack-risk-classify. Judgment about
"what stage comes next" is precisely the thing that drifts when a model improvises
it fresh each time, and a pipeline that quietly reorders itself is a pipeline whose
gates can be skipped.

Usage:
    gstack-pipeline --kind feature              # print every stage, in order
    gstack-pipeline --kind feature --after qa   # print the stage AFTER qa
    gstack-pipeline --kinds                     # list known kinds

Exit codes:
    0  ok (for --after: printed the next stage)
    2  unknown kind
    3  unknown stage for that kind
    4  no next stage — the pipeline is complete
"""
import argparse
import sys

# kind -> ordered stages. Each stage names an existing gstack skill, except
# "build", which is the work itself.
PIPELINES = {
    "feature":  ["spec", "plan-eng-review", "build", "qa", "review", "ship"],
    "bug":      ["build", "qa", "review", "ship"],
    "refactor": ["build", "review", "health", "ship"],
    "docs":     ["build", "document-release"],
    "incident": ["investigate", "build", "qa", "review", "ship", "canary"],
    "chore":    ["build", "review"],
}


def stages(kind):
    return PIPELINES.get(kind)


def main():
    p = argparse.ArgumentParser(prog="gstack-pipeline")
    p.add_argument("--kind")
    p.add_argument("--after", default=None)
    p.add_argument("--kinds", action="store_true")
    args = p.parse_args()

    if args.kinds:
        for k in sorted(PIPELINES):
            print(k)
        return

    if not args.kind:
        p.error("--kind is required unless --kinds is given")

    seq = stages(args.kind)
    if seq is None:
        sys.stderr.write(
            "unknown kind %r. Known kinds: %s\n" % (args.kind, ", ".join(sorted(PIPELINES)))
        )
        sys.exit(2)

    if args.after is None:
        for s in seq:
            print(s)
        return

    if args.after not in seq:
        sys.stderr.write(
            "%r is not a stage of kind %r. Its stages are: %s\n"
            % (args.after, args.kind, ", ".join(seq))
        )
        sys.exit(3)

    i = seq.index(args.after)
    if i + 1 >= len(seq):
        sys.stderr.write(
            "%r is the last stage of kind %r — the pipeline is complete.\n"
            % (args.after, args.kind)
        )
        sys.exit(4)
    print(seq[i + 1])


if __name__ == "__main__":
    main()

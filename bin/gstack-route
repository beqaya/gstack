#!/usr/bin/env python3
"""gstack-route — resolve a spoken intent to exactly one skill.

Routing by prose drifts. Two suites are installed — gstack (60 skills) and
cyberteam (61) — and picking the wrong one costs a full skill load, up to 26,851
tokens, before the mistake is visible.

This is a lookup, not a judgement, exactly like gstack-risk-classify. The index
is DERIVED from `triggers:` frontmatter rather than hand-maintained, so a skill
that declares a phrase owns it and nothing has to be kept in sync by hand.

A miss is reported, never guessed. That is the point: an intent nobody claims is
data for adding a row, and a silent guess produces no data at all.

Usage:
    gstack-route --intent "check for vulnerabilities"
    gstack-route --scan "could you check for vulnerabilities in the login flow"
    gstack-route --unrouted
    gstack-route --index

--intent is exact whole-phrase equality; --scan finds every trigger phrase
CONTAINED in the text (word-boundary), longest first, dropping phrases that
sit inside a longer matched phrase. Scan exists for the prompt hook: a real
sentence never equals a trigger verbatim, but it usually contains one.

Exit codes:
    0  resolved (or listing completed)
    2  no skill claims that phrase (--intent) / no phrase found in text (--scan)
    3  more than one skill claims it (--intent only; --scan reports all owners)
    4  no skills found on disk
    5  usage error (bad or missing CLI arguments) — kept separate from 2 so a
       downstream consumer harvesting unclaimed intents can tell a real miss
       from a malformed invocation
"""
import argparse
import json
import os
import re
import sys

# Inventory comes from SKILL.md — the artifact actually installed — for BOTH
# suites. Reading templates instead would have missed `delegate` and
# `session-lock` (no template) and invented a skill called `claude` (template,
# no SKILL.md). Generated SKILL.md retains `triggers:`; only `voice-triggers:`
# is folded into the description, so the template is read as a second source
# where it exists.
SUITES = (
    ("gstack", "~/.claude/skills/gstack/*/SKILL.md"),
    ("cyber", "~/.claude/skills/cyberteam/skills/*/SKILL.md"),
)
TRIGGER_KEYS = ("triggers", "voice-triggers")

STOPWORDS = frozenset(
    "a an the do does did done doing to for of in on at with and or this "
    "that these those is are was were be been being it its my your our "
    "their i you we they me him her us them please can could would should "
    "will shall may might let lets".split()
)


def normalise(phrase):
    """Compare what a reader would hear, not what they typed.

    Punctuation, case and repeated whitespace carry no routing meaning, and a
    table that treats "QA test this" and "qa  test this." as different
    phrases is a table with silent holes in it.
    """
    # Collapse whitespace BEFORE stripping punctuation. The other order deletes
    # a tab outright — it is not in the allowed class — so "check\tfor" became
    # "checkfor", words glued together, which no later split can undo. Doing it
    # this way also keeps "don't" as "dont" rather than "don t".
    collapsed = re.sub(r"\s+", " ", (phrase or "").lower())
    cleaned = re.sub(r"[^a-z0-9 ]+", "", collapsed)
    return " ".join(cleaned.split())


def content_words(phrase):
    """Words worth matching on for a near-miss suggestion.

    Filters function words ("do", "the", "and", ...) so two phrases that
    merely share a stopword don't look related — "do security testing" would
    otherwise tie with any phrase containing "do". Falls back to the
    unfiltered set if filtering would leave nothing, so an all-stopword
    phrase can still be found rather than vanishing from every comparison.
    """
    words = set(phrase.split())
    return words - STOPWORDS or words


def strip_comment(text):
    """Drop a trailing `# comment` — but not a `#` sitting inside quotes."""
    in_single = in_double = False
    for idx, ch in enumerate(text):
        if ch == "'" and not in_double:
            in_single = not in_single
        elif ch == '"' and not in_single:
            in_double = not in_double
        elif ch == "#" and not in_single and not in_double:
            return text[:idx]
    return text


def frontmatter(text):
    """The YAML frontmatter block only — between the first `---` fence and
    the next, never the document body.

    Triggers are frontmatter by definition; a `triggers:` block appearing
    later in the body is documentation (skillify's generated output shows a
    placeholder one) and must never be indexed. Restricting the scan to this
    region removes that ordering risk structurally instead of relying on the
    real block happening to come first.
    """
    stripped = text.lstrip("\ufeff \t\r\n")
    if not stripped.startswith("---"):
        return ""
    lines = stripped.splitlines(True)
    if lines[0].strip() != "---":
        return ""
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return "".join(lines[1:i])
    return ""


def extract_triggers(frontmatter_text, key):
    """Values under `key:` in the frontmatter, however the block is styled.

    Handles a block sequence (indented, or at column 0 — both are valid
    YAML), an inline flow list (`key: ["a", "b"]`), and strips a trailing
    `# comment` from each item — forms a whitespace-anchored regex silently
    dropped, which sent the skill to --unrouted instead of indexing it.
    """
    lines = frontmatter_text.splitlines()
    for i, line in enumerate(lines):
        m = re.match(r"^%s:\s*(.*)$" % re.escape(key), line)
        if m is None:
            continue
        rest = strip_comment(m.group(1)).strip()
        if rest.startswith("["):
            inner = rest.strip("[]")
            return [v for v in (part.strip().strip("\"'") for part in inner.split(",")) if v]
        values = []
        j = i + 1
        while j < len(lines):
            item_line = lines[j].strip()
            if not item_line:
                j += 1
                continue
            if not item_line.startswith("-"):
                break
            item = strip_comment(item_line[1:]).strip().strip("\"'")
            if item:
                values.append(item)
            j += 1
        return values
    return []


def skill_files():
    """(suite, name, [files to read]) for every INSTALLED skill."""
    import glob
    found = []
    for suite, pattern in SUITES:
        for path in sorted(glob.glob(os.path.expanduser(pattern))):
            sources = [path]
            template = path + ".tmpl"
            if os.path.exists(template):
                sources.append(template)
            found.append((suite, os.path.basename(os.path.dirname(path)), sources))
    return found


def self_name_phrases(name):
    """The phrases a skill's own name should answer to.

    Two forms: hyphens-as-spaces ("plan ceo review" — how a name is spoken)
    and the glued normalisation of the raw name ("planceoreview" — what a
    typed "plan-ceo-review" becomes after normalise strips the hyphens).
    """
    return {normalise(name.replace("-", " ")), normalise(name)} - {""}


def build_index():
    """phrase -> sorted list of "suite:skill" owners, plus the unrouted skills.

    A skill's own name is an IMPLICIT trigger: 91 of 106 skills never claimed
    their name, so the most likely thing a user types was a guaranteed miss.
    Explicit `triggers:` always win — an implicit name never joins a phrase
    another skill already claims, so it can never create a contest.
    --unrouted still reports skills with no EXPLICIT triggers: its job is to
    say where frontmatter work is missing, not whether a name matches itself.
    """
    index, unrouted = {}, []
    implicit = []  # (phrase, owner), applied after every explicit claim is in
    for suite, name, sources in skill_files():
        owner = "%s:%s" % (suite, name)
        claimed = False
        for path in sources:
            try:
                with open(path, "r", encoding="utf-8", errors="replace") as fh:
                    text = fh.read()
            except OSError:
                continue
            fm = frontmatter(text)
            if not fm:
                continue
            for key in TRIGGER_KEYS:
                for raw in extract_triggers(fm, key):
                    phrase = normalise(raw)
                    if not phrase:
                        continue
                    claimed = True
                    owners = index.setdefault(phrase, [])
                    if owner not in owners:
                        owners.append(owner)
        for phrase in self_name_phrases(name):
            implicit.append((phrase, owner))
        if not claimed:
            unrouted.append(owner)
    for phrase, owner in implicit:
        owners = index.setdefault(phrase, [])
        if not owners:
            owners.append(owner)
    for owners in index.values():
        owners.sort()
    return index, sorted(unrouted)


def scan_text(index, text):
    """Trigger phrases contained in the text, longest first.

    Containment is word-boundary ("qa" never matches inside "quality"), and a
    phrase wholly inside a longer matched phrase is dropped — "security
    review" beating "review" is the whole reason to prefer length. Returns
    [(phrase, owners)] with owners as the index stores them.
    """
    haystack = " %s " % normalise(text)
    hits = [p for p in index if " %s " % p in haystack]
    hits.sort(key=len, reverse=True)
    kept = []
    for p in hits:
        if any(" %s " % p in " %s " % longer for longer in kept):
            continue
        kept.append(p)
    return [(p, index[p]) for p in kept]


def near_misses(index, phrase, limit=5):
    """Phrases sharing a content word with the request — what to suggest on a miss."""
    query_words = content_words(phrase)
    scored = [(len(query_words & content_words(p)), p) for p in index]
    return [p for score, p in sorted(scored, reverse=True) if score][:limit]


class RouteArgumentParser(argparse.ArgumentParser):
    """argparse's default error() exits 2 — the same code this tool uses for
    "no skill claims that phrase". A consumer harvesting unclaimed intents
    from exit 2 couldn't tell a real miss from a typo'd flag, so usage
    errors get their own code (5) instead.
    """

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(5, "%s: error: %s\n" % (self.prog, message))


def main():
    ap = RouteArgumentParser(prog="gstack-route")
    ap.add_argument("--intent")
    ap.add_argument("--scan")
    ap.add_argument("--unrouted", action="store_true")
    ap.add_argument("--index", action="store_true")
    args = ap.parse_args()

    index, unrouted = build_index()
    if not index and not unrouted:
        sys.stderr.write("no skills found on disk — nothing to route against.\n")
        sys.exit(4)

    if args.index:
        print(json.dumps(index, indent=2, sort_keys=True))
        return
    if args.unrouted:
        for owner in unrouted:
            print(owner)
        return
    if args.scan is not None:
        matches = scan_text(index, args.scan)
        if not matches:
            sys.exit(2)
        for phrase, owners in matches:
            print("%s\t%s" % (phrase, ",".join(owners)))
        return
    if not args.intent:
        ap.error("--intent is required unless --scan, --unrouted or --index is given")

    phrase = normalise(args.intent)
    owners = index.get(phrase, [])
    if len(owners) == 1:
        print(owners[0])
        return
    if not owners:
        sys.stderr.write(
            "no skill claims %r. Closest phrases: %s\n"
            "Nothing was guessed. If a skill should own this, add it to that "
            "skill's `triggers:` frontmatter.\n"
            % (args.intent, ", ".join(near_misses(index, phrase)) or "(none)")
        )
        sys.exit(2)
    sys.stderr.write(
        "%r is claimed by %d skills: %s. One phrase must have one owner — "
        "remove it from all but one.\n" % (args.intent, len(owners), ", ".join(owners))
    )
    sys.exit(3)


if __name__ == "__main__":
    main()

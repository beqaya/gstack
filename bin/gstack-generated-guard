#!/usr/bin/env python3
"""gstack-generated-guard — PreToolUse hook: blocks Edit/Write to GENERATED files.

Reads the PreToolUse JSON payload on stdin (tool_input.file_path per the
freeze/SKILL.md hook contract) and denies the edit if the target resolves to a
generated artifact: a mirrored adapter-tree copy, a file with a sibling
<file>.tmpl source, or a file whose first 5 lines carry the AUTO-GENERATED
marker. The deny message names the real source to edit and the regeneration
command, so the edit gets redirected instead of silently reverted later.

Escape hatch: an out-of-band, single-use sentinel file at
~/.gstack/.allow-generated-edit. It must exist AND be under 5 minutes old.
This is deliberately NOT a signal inside the tool-call payload — a payload
field (including a "rationale" or token embedded in new_string) is content
the agent being guarded controls, so checking the payload for a magic string
means the thing the guard blocks can also unblock itself. The sentinel lives
outside the payload the Edit/Write tool ever sees, so no edit content can
forge it. It is consumed (deleted) on the first inspection, fresh or stale,
so it can never authorise more than one edit and a forgotten sentinel does
not stay armed.

FAIL OPEN is mandatory: any exception, unreadable path, or malformed payload
must ALLOW the edit and log to guard-errors.jsonl. A guard that blocks work
when it malfunctions gets disabled and then guards nothing.
"""
import sys
import os
import json
import datetime

HOME = os.path.expanduser("~")
GSTACK_DIR = os.path.join(HOME, ".gstack")
ANALYTICS_DIR = os.path.join(GSTACK_DIR, "analytics")
OVERRIDE_LOG = os.path.join(ANALYTICS_DIR, "generated-overrides.jsonl")
ERROR_LOG = os.path.join(ANALYTICS_DIR, "guard-errors.jsonl")
SENTINEL_PATH = os.path.join(GSTACK_DIR, ".allow-generated-edit")
SENTINEL_MAX_AGE_SECONDS = 5 * 60
SCRATCH_SENTINEL_PATH = os.path.join(GSTACK_DIR, ".scratch-mode")
SCRATCH_MAX_AGE_SECONDS = 30 * 60
SCRATCH_CLEAR_CMD = 'Remove-Item -Force "$env:USERPROFILE\\.gstack\\.scratch-mode"'
REGEN_CMD = "bun run gen:skill-docs -- --catalog-mode=full"
GENERIC_SOURCE = "the resolver/template under scripts/ that emits this"
SENTINEL_CREATE_CMD = (
    'New-Item -ItemType Directory -Force -Path "$env:USERPROFILE\\.gstack" | Out-Null; '
    'New-Item -ItemType File -Force -Path "$env:USERPROFILE\\.gstack\\.allow-generated-edit" | Out-Null'
)

ADAPTER_DIRS = [
    ".agents", ".cursor", ".factory", ".gbrain", ".hermes",
    ".kiro", ".openclaw", ".opencode", ".slate",
]


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def log_jsonl(path, record):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(record) + "\n")
    except Exception:
        pass


def check_sentinel_override(file_path, reason):
    """Check the out-of-band sentinel and consume it if present.

    Returns True iff a FRESH (< SENTINEL_MAX_AGE_SECONDS old) sentinel was
    found, in which case the override is logged and the edit should be
    allowed. In every case where the sentinel file exists — fresh or
    expired — it is deleted here, so a single sentinel authorises at most
    one edit and a stale one can never authorise anything.
    """
    if not os.path.isfile(SENTINEL_PATH):
        return False

    try:
        mtime = os.path.getmtime(SENTINEL_PATH)
        age_seconds = datetime.datetime.now().timestamp() - mtime
    except Exception:
        age_seconds = SENTINEL_MAX_AGE_SECONDS + 1  # treat unreadable as expired

    try:
        os.remove(SENTINEL_PATH)
    except Exception:
        pass

    if age_seconds > SENTINEL_MAX_AGE_SECONDS:
        return False

    log_jsonl(OVERRIDE_LOG, {
        "path": file_path,
        "reason": reason,
        "ts": now_iso(),
        "mechanism": "sentinel",
    })
    return True


def check_scratch_mode():
    """Check the /scratch sentinel and report whether scratch mode blocks this edit.

    Returns a deny message if the sentinel exists and is fresh (< 30 minutes
    old) — scratch mode is active, so every Edit/Write is blocked, not just
    edits to generated files. Returns None if the sentinel is absent, or if
    it is present but expired: an expired sentinel means the session that
    armed it likely died before it could clean up, so it is deleted here
    (not just ignored) and the edit falls through to the normal generated-
    file checks below. This is the guard against a dead /scratch session
    wedging editing on this machine forever.
    """
    if not os.path.isfile(SCRATCH_SENTINEL_PATH):
        return None

    try:
        mtime = os.path.getmtime(SCRATCH_SENTINEL_PATH)
        age_seconds = datetime.datetime.now().timestamp() - mtime
    except Exception:
        age_seconds = SCRATCH_MAX_AGE_SECONDS + 1  # treat unreadable as expired

    if age_seconds > SCRATCH_MAX_AGE_SECONDS:
        try:
            os.remove(SCRATCH_SENTINEL_PATH)
        except Exception:
            pass
        return None

    return (
        "[gstack-generated-guard] Blocked: scratch mode is active — /scratch "
        "promises a read-only side answer, so no Edit or Write is permitted "
        "until it finishes. This block is structural, not a request: it "
        "applies to every file, not just generated ones. If scratch mode is "
        "stuck (its session ended before it could clean up), clear it "
        f"yourself: {SCRATCH_CLEAR_CMD} — or just wait, it self-expires 30 "
        "minutes after it started."
    )


def allow():
    # Stay neutral: an explicit permissionDecision "allow" is a positive
    # override that auto-approves the call and could mask a sibling hook's
    # deny (e.g. check-freeze.sh in the same Write|Edit group). Silence
    # means "no opinion" and lets the rest of the permission system run.
    sys.exit(0)


def deny(message):
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": message,
        }
    }) + "\n")
    sys.exit(0)


def find_adapter_source(file_path):
    """Map an adapter-tree copy back to its repo .tmpl source.

    Expected shape: <repo-root>/<adapter>/skills/gstack-<name>/SKILL.md
    (or <repo-root>/<adapter>/skills/gstack/SKILL.md for the router skill).
    Returns the candidate repo path, or None if the shape doesn't match.
    """
    norm = file_path.replace("\\", "/")
    parts = [p for p in norm.split("/") if p != ""]
    lower_parts = [p.lower() for p in parts]
    for adapter in ADAPTER_DIRS:
        if adapter not in lower_parts:
            continue
        idx = lower_parts.index(adapter)
        if idx + 2 < len(parts) and lower_parts[idx + 1] == "skills":
            slug = parts[idx + 2]
            name = slug[len("gstack-"):] if slug.startswith("gstack-") else slug
            repo_root = "/".join(parts[:idx])
            return f"{repo_root}/{name}/SKILL.md.tmpl"
    return None


def main():
    # Some Windows shells (PowerShell piping to a native process) prepend a
    # UTF-8 BOM to stdin. Decode via utf-8-sig so that doesn't break
    # json.loads and silently trigger the fail-open path below.
    raw = sys.stdin.buffer.read().decode("utf-8-sig", errors="replace")

    try:
        payload = json.loads(raw)
    except Exception:
        allow()
        return

    scratch_block = check_scratch_mode()
    if scratch_block:
        deny(scratch_block)
        return

    tool_input = payload.get("tool_input") or {}
    file_path = tool_input.get("file_path") or ""
    if not file_path:
        allow()
        return

    norm_lower_parts = [p.lower() for p in file_path.replace("\\", "/").split("/") if p != ""]
    under_adapter = any(a in norm_lower_parts for a in ADAPTER_DIRS)

    tmpl_sibling = file_path + ".tmpl"
    tmpl_exists = os.path.isfile(tmpl_sibling)

    marker_hit = False
    if os.path.isfile(file_path):
        try:
            with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                first_lines = [next(f, "") for _ in range(5)]
            marker_hit = any("AUTO-GENERATED" in line for line in first_lines)
        except Exception:
            marker_hit = False

    # Detection order per plan: adapter tree, then .tmpl sibling, then marker.
    # First match wins for the purpose of naming the source.
    if under_adapter:
        reason = "adapter"
    elif tmpl_exists:
        reason = "tmpl"
    elif marker_hit:
        reason = "marker"
    else:
        allow()
        return

    if check_sentinel_override(file_path, reason):
        allow()
        return

    if reason == "adapter":
        mapped = find_adapter_source(file_path)
        source = mapped if (mapped and os.path.isfile(mapped)) else GENERIC_SOURCE
    elif reason == "tmpl":
        source = tmpl_sibling
    else:
        source = GENERIC_SOURCE

    message = (
        f"[gstack-generated-guard] Blocked: {file_path} is a GENERATED file "
        f"and edits to it are silently reverted on the next regeneration. "
        f"Edit the source instead: {source}. "
        f"Regenerate with: {REGEN_CMD} — then run /parity to sync repo -> live copies. "
        f"If this edit is genuinely intentional (e.g. an emergency hotfix to a "
        f"shipped artifact), authorise it out-of-band: run this on the machine "
        f"running the edit, then retry the SAME edit within 5 minutes (it is "
        f"single-use): {SENTINEL_CREATE_CMD} "
        f"The override is logged to {OVERRIDE_LOG}."
    )
    deny(message)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        log_jsonl(ERROR_LOG, {"ts": now_iso(), "error": repr(e), "error_type": type(e).__name__})
        allow()

#!/usr/bin/env bash
# gstack-freeze-wire — install/remove the /freeze enforcement hook in
# ~/.claude/settings.json.
#
# /freeze's SKILL.md declares a `hooks:` block in its frontmatter, but the
# harness does not auto-register frontmatter hooks (gstack is not an
# enabled plugin here) — so nothing ever invoked check-freeze.sh and the
# boundary was never enforced. This helper is the real wiring: it appends
# a hook entry for check-freeze.sh into the settings.json PreToolUse
# "Write|Edit" matcher that already exists (the same matcher the user's
# pre-existing auto-stash hook and gstack-generated-guard live under),
# rather than creating a second, separate matcher entry for the same tools.
#
# Usage:
#   gstack-freeze-wire --install    # add the check-freeze.sh hook (idempotent)
#   gstack-freeze-wire --remove     # remove it (idempotent, no-op if absent)
#
# Safety:
#   - Backs up settings.json to settings.json.bak.freeze-wire.<ts> before
#     any write, and validates the result still parses as JSON. On
#     validation failure, restores the backup and exits non-zero.
#   - Touches ONLY the hook entry whose command contains "check-freeze.sh"
#     inside the PreToolUse "Write|Edit" matcher. Every other hook
#     (auto-stash, gstack-generated-guard, SessionStart, PreCompact, Stop,
#     UserPromptSubmit, and any other PreToolUse matcher) is left byte-for-
#     byte alone.
set -euo pipefail

ACTION="${1:-}"
SETTINGS_FILE="${GSTACK_SETTINGS_FILE:-$HOME/.claude/settings.json}"
MATCHER="Write|Edit"
MARKER="check-freeze.sh"
CHECK_FREEZE_SCRIPT="$HOME/.claude/skills/gstack/freeze/bin/check-freeze.sh"
HOOK_COMMAND="${GSTACK_FREEZE_HOOK_COMMAND:-bash \"$CHECK_FREEZE_SCRIPT\"}"

usage() {
  cat <<EOF >&2
Usage:
  gstack-freeze-wire --install   # add the check-freeze.sh PreToolUse hook
  gstack-freeze-wire --remove    # remove it
EOF
  exit 1
}

case "$ACTION" in
  --install) MODE=install ;;
  --remove)  MODE=remove ;;
  *) usage ;;
esac

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: bun is required but not installed." >&2
  exit 1
fi

if [ ! -f "$SETTINGS_FILE" ]; then
  echo "Error: settings file not found at $SETTINGS_FILE" >&2
  exit 1
fi

TS=$(date +%Y%m%d-%H%M%S)
BACKUP="$SETTINGS_FILE.bak.freeze-wire.$TS"
cp "$SETTINGS_FILE" "$BACKUP"

set +e
GSTACK_SETTINGS_PATH="$SETTINGS_FILE" \
GSTACK_MATCHER="$MATCHER" \
GSTACK_MARKER="$MARKER" \
GSTACK_HOOK_COMMAND="$HOOK_COMMAND" \
GSTACK_MODE="$MODE" \
bun -e '
  const fs = require("fs");
  const settingsPath = process.env.GSTACK_SETTINGS_PATH;
  const matcher = process.env.GSTACK_MATCHER;
  const marker = process.env.GSTACK_MARKER;
  const hookCommand = process.env.GSTACK_HOOK_COMMAND;
  const mode = process.env.GSTACK_MODE;

  const settings = JSON.parse(fs.readFileSync(settingsPath, "utf8"));

  if (!settings.hooks) settings.hooks = {};
  if (!settings.hooks.PreToolUse) settings.hooks.PreToolUse = [];

  let entry = settings.hooks.PreToolUse.find(e => e.matcher === matcher);

  if (mode === "install") {
    if (!entry) {
      entry = { matcher, hooks: [] };
      settings.hooks.PreToolUse.push(entry);
    }
    if (!entry.hooks) entry.hooks = [];
    const already = entry.hooks.some(h => h.command && h.command.includes(marker));
    if (!already) {
      entry.hooks.push({ type: "command", command: hookCommand, timeout: 5 });
      console.log("OK: installed freeze hook into PreToolUse[" + matcher + "]");
    } else {
      console.log("OK: freeze hook already installed (no change)");
    }
  } else {
    if (entry && Array.isArray(entry.hooks)) {
      const before = entry.hooks.length;
      entry.hooks = entry.hooks.filter(h => !(h.command && h.command.includes(marker)));
      const removedCount = before - entry.hooks.length;
      if (entry.hooks.length === 0) {
        settings.hooks.PreToolUse = settings.hooks.PreToolUse.filter(e => e !== entry);
      }
      if (settings.hooks.PreToolUse.length === 0) delete settings.hooks.PreToolUse;
      if (Object.keys(settings.hooks).length === 0) delete settings.hooks;
      console.log("OK: removed " + removedCount + " freeze hook entry/entries");
    } else {
      console.log("OK: no freeze hook present (no change)");
    }
  }

  const tmp = settingsPath + ".tmp";
  fs.writeFileSync(tmp, JSON.stringify(settings, null, 2) + "\n");
  fs.renameSync(tmp, settingsPath);
'
BUN_STATUS=$?
set -e

if [ "$BUN_STATUS" -ne 0 ]; then
  echo "ERROR: failed to update $SETTINGS_FILE — leaving original untouched (backup at $BACKUP unused)" >&2
  exit 1
fi

if ! bun -e "JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8'))" "$SETTINGS_FILE" >/dev/null 2>&1; then
  echo "ERROR: $SETTINGS_FILE failed JSON validation after edit — restoring backup from $BACKUP" >&2
  cp "$BACKUP" "$SETTINGS_FILE"
  exit 1
fi

echo "$BACKUP" > "$SETTINGS_FILE.bak-freeze-wire-latest"
echo "Backup: $BACKUP"

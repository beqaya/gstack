#!/usr/bin/env python3
"""gstack-run — sole writer of unattended-run state.

A run is a directory, not a process. State lives under
<state-root>/runs/<run-id>/ and survives the session that created it, so a
run resumes from disk rather than from a surviving process.

Usage:
    gstack-run init --goal <text> --budget <tokens>
    gstack-run status --run <run-id>

State root: $GSTACK_STATE_ROOT, else ~/.gstack

Files:
    manifest.json   whole-file rewrite; carries "schema" for version gating
    queue.jsonl     append-only work items and transitions
    journal.jsonl   append-only claims with verdict + evidence
    parked.jsonl    append-only items blocked on founder approval
    ledger.jsonl    append-only token spend

Every file except manifest.json and resume.json is append-only. Appends at
these sizes are atomic, so concurrent workers cannot corrupt each other, and
a crash mid-write loses at most the trailing line rather than the file.
"""
import argparse
import errno
import json
import os
import re
import sys
import time
import unicodedata
import uuid
from datetime import datetime, timezone

SCHEMA = 1
VERDICTS = ("PROVEN", "UNPROVEN", "CONTRADICTED")


def now_ts():
    return datetime.now(timezone.utc).isoformat()


def state_root():
    return os.environ.get("GSTACK_STATE_ROOT") or os.path.join(
        os.path.expanduser("~"), ".gstack"
    )


def run_dir(run_id):
    return os.path.join(state_root(), "runs", run_id)


def read_manifest(run_id):
    path = os.path.join(run_dir(run_id), "manifest.json")
    if not os.path.exists(path):
        # 21, not 2: argparse exits 2 on a usage error, so a caller branching on
        # 2 could not tell "this run does not exist" from "you passed a bad flag".
        sys.stderr.write("no such run: %s\n" % run_id)
        sys.exit(21)
    with open(path, "r", encoding="utf-8") as fh:
        m = json.load(fh)
    if m.get("schema") != SCHEMA:
        sys.stderr.write(
            "unsupported schema %r (expected %d) — halting rather than guessing\n"
            % (m.get("schema"), SCHEMA)
        )
        sys.exit(3)
    return m


def atomic_write_json(path, data):
    """Write JSON via a sibling temp file + os.replace, which is atomic.

    A crash mid-write to the real path leaves a truncated manifest or resume
    file; a crash mid-write to the temp file leaves the real file untouched.
    The temp file is written next to the target (same directory, same
    volume) because os.replace across volumes raises on Windows.
    """
    # Unique per call: two concurrent writers (e.g. two `stop` calls on one run)
    # sharing a fixed ".tmp" name would interleave and one could os.replace the
    # other's half-written file into place.
    tmp = "%s.%d.%s.tmp" % (path, os.getpid(), uuid.uuid4().hex[:8])
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def append_jsonl(run_id, name, record):
    record.setdefault("ts", now_ts())
    path = os.path.join(run_dir(run_id), name)
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(record) + "\n")
    return record


def read_jsonl_counted(run_id, name):
    """Read a JSONL file, returning (records, unreadable_line_count).

    Callers that guarantee something to a human — the founder's approval list,
    the work queue — must fail closed when a line is unreadable rather than
    quietly returning a short list. Silently skipping is only safe where a
    partial read cannot break a promise.
    """
    path = os.path.join(run_dir(run_id), name)
    if not os.path.exists(path):
        return [], 0
    out, bad = [], 0
    with open(path, "r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                bad += 1
                continue
            # Valid JSON of the wrong shape is unreadable for our purposes: every
            # consumer expects an object and would otherwise raise a KeyError or
            # AttributeError deep in a caller, producing a raw traceback and exit
            # 1 instead of one of this file's deliberate codes.
            if not isinstance(rec, dict):
                bad += 1
                continue
            out.append(rec)
    return out, bad


def read_jsonl(run_id, name):
    records, _ = read_jsonl_counted(run_id, name)
    return records


def lock_path(run_id, item_id):
    return os.path.join(run_dir(run_id), "locks", "%s.lock" % item_id)


def lock_ttl():
    """How long a claim survives without being renewed.

    Nothing refreshes a lock's heartbeat, so this is a hard cap on how long a
    single item may take before another worker treats it as abandoned and takes
    it. At the previous 900s an ordinary long item — a refactor, a broad test
    run — outlived its own claim and got picked up a second time, with both
    workers editing the same files.

    Two hours is a mitigation, not the fix: `done` and `park` still take no
    --worker, so they do not check who owns the lock they release. The real fix
    is an ownership check, or a heartbeat the supervisor refreshes between
    steps. Until then this makes the failure rare rather than routine.
    """
    return int(os.environ.get("GSTACK_LOCK_TTL_SEC", "7200"))


def lock_is_stale(path):
    """Has this lock expired?

    The heartbeat inside the file is authoritative. When the file cannot be
    parsed we fall back to its age, and a file younger than the TTL is NEVER
    stale: a lock is empty for a moment between the O_EXCL create that commits
    ownership and the heartbeat write that follows, and without the age guard
    a concurrent reaper reads that empty file, calls it abandoned, and deletes
    a lock its owner is actively holding. Only an unparseable file OLDER than
    the TTL is treated as abandoned, rather than allowed to strand work
    forever.
    """
    try:
        with open(path, "r", encoding="utf-8") as fh:
            hb = json.load(fh).get("heartbeat")
        age = (datetime.now(timezone.utc) - datetime.fromisoformat(hb)).total_seconds()
        return age > lock_ttl()
    except FileNotFoundError:
        return False
    except Exception:
        try:
            st = os.stat(path)
        except FileNotFoundError:
            return False
        except OSError:
            # Cannot judge this file right now (e.g. a Windows sharing
            # violation). Report it live rather than stale: refusing to reap
            # an abandoned lock merely delays reclaim until the next pass,
            # whereas deleting a lock someone is holding hands the same item
            # to two workers.
            return False
        return (time.time() - st.st_mtime) > lock_ttl()


def reap_stale_locks(run_id):
    """Delete lock files whose heartbeat has expired.

    Idempotent and ownership-free: two workers reaping the same lock is
    harmless, because deleting a lock grants nobody the item. Whoever then
    wins the O_EXCL create in try_lock owns it.
    """
    d = os.path.join(run_dir(run_id), "locks")
    try:
        names = os.listdir(d)
    except FileNotFoundError:
        return
    for name in names:
        if not name.endswith(".lock"):
            continue
        p = os.path.join(d, name)
        if lock_is_stale(p):
            try:
                os.unlink(p)
            except OSError:
                pass  # someone else reaped it, or it is briefly locked on Windows


def try_lock(run_id, item_id, worker):
    """Acquire an item. Correct by construction: an O_EXCL create is the ONLY
    way to acquire, and it is atomic, so two workers can never both win.

    Expired locks are cleared separately by reap_stale_locks(), which grants
    no ownership — it only deletes. Earlier designs tried to steal a stale lock
    in place (check, unlink, recreate); that is three syscalls with gaps, and
    two revisions failed to close the resulting double-claim window. Reaping and
    acquiring are kept apart precisely so acquisition stays a single atomic act.
    """
    path = lock_path(run_id, item_id)
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except OSError as e:
        if e.errno != errno.EEXIST:
            raise
        return False
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps({"worker": worker, "heartbeat": now_ts()}))
    return True


def open_items(run_id):
    """Items added but not done, newest status wins."""
    status = {}
    titles = {}
    for rec in read_jsonl(run_id, "queue.jsonl"):
        iid = rec.get("item_id")
        if iid is None or "event" not in rec:
            continue  # wrong-shaped line: skip rather than raise a KeyError
        if rec["event"] == "add":
            titles[iid] = rec["title"]
        status[iid] = rec["event"]
    # `done` and `skip` are both terminal: a skipped item is a poison unit the
    # convoy stepped over so the rest could finish (Gastown's stall-skip), and
    # must never be handed out again.
    return [(i, titles.get(i, "")) for i, s in status.items() if s not in ("done", "skip")]


# A unit claimed this many times without reaching `done` is treated as poison:
# it stalls the convoy, so the supervisor skips it and moves on rather than
# reclaiming it forever. Each stale-lock reap re-opens the item, so without a
# ceiling one hung unit blocks an overnight run indefinitely.
SKIP_AFTER_CLAIMS = 3


def claim_count(run_id, item_id):
    """How many times this item has been claimed (proxy for failed attempts)."""
    n = 0
    for rec in read_jsonl(run_id, "queue.jsonl"):
        if rec.get("item_id") == item_id and rec.get("event") == "claim":
            n += 1
    return n


def pipeline_stages(kind):
    """Stages for a kind, asked of gstack-pipeline rather than duplicated here.

    A second copy of the table would drift from the first — that already happened
    once in this codebase, when a missing-ledger fix landed in the budget hook but
    not in the CLI that shares its logic, and the two disagreed. One table, one
    owner, a subprocess hop to reach it.
    """
    if not kind:
        return []
    import subprocess
    script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "gstack-pipeline")
    try:
        out = subprocess.run([sys.executable, script, "--kind", kind],
                             capture_output=True, text=True, timeout=15)
    except Exception:
        return []
    if out.returncode != 0:
        return []
    return [s.strip() for s in out.stdout.splitlines() if s.strip()]


def item_kind(run_id, item_id):
    for rec in read_jsonl(run_id, "queue.jsonl"):
        if rec.get("event") == "add" and rec.get("item_id") == item_id:
            return rec.get("kind")
    return None


def next_stage(run_id, item_id):
    """The first stage of this item's pipeline not yet closed with PROVEN.

    Stage completion is read from the journal, so it survives the session that
    did the work — resuming mid-pipeline is the same code path as starting it.
    """
    seq = pipeline_stages(item_kind(run_id, item_id))
    if not seq:
        return None
    done_stages = {e.get("stage") for e in read_jsonl(run_id, "journal.jsonl")
                   if e.get("item_id") == item_id and e.get("verdict") == "PROVEN"}
    for s in seq:
        if s not in done_stages:
            return s
    return None


def cmd_add(args):
    read_manifest(args.run)
    if args.kind and not pipeline_stages(args.kind):
        sys.stderr.write(
            "unknown kind %r — it has no pipeline, so nothing would tell a worker "
            "what to run. See: gstack-pipeline --kinds\n" % args.kind
        )
        sys.exit(20)
    item_id = uuid.uuid4().hex[:10]
    append_jsonl(args.run, "queue.jsonl",
                 {"event": "add", "item_id": item_id, "title": args.title,
                  "kind": args.kind})
    print(item_id)


def cmd_claim(args):
    read_manifest(args.run)
    _, bad_queue = read_jsonl_counted(args.run, "queue.jsonl")
    if bad_queue:
        sys.stderr.write(
            "%d unreadable line(s) in queue.jsonl — refusing to hand out work. "
            "A corrupted 'add' line makes an item invisible, so the run would "
            "report the queue drained while work was silently lost.\n" % bad_queue
        )
        sys.exit(11)
    reap_stale_locks(args.run)
    for item_id, title in open_items(args.run):
        # Stall-skip: a unit re-claimed too many times without finishing is
        # poison. Step over it (record the skip so it's visible) and keep the
        # convoy moving rather than handing it out a fourth time.
        if claim_count(args.run, item_id) >= SKIP_AFTER_CLAIMS:
            append_jsonl(args.run, "queue.jsonl",
                         {"event": "skip", "item_id": item_id,
                          "reason": "claimed %d times without done" % SKIP_AFTER_CLAIMS})
            append_jsonl(args.run, "journal.jsonl",
                         {"event": "skip", "item_id": item_id, "title": title,
                          "reason": "stall-skip after %d claims" % SKIP_AFTER_CLAIMS})
            sys.stderr.write("skipped poison item %s (%s): claimed %d times without done\n"
                             % (item_id, title, SKIP_AFTER_CLAIMS))
            continue
        if try_lock(args.run, item_id, args.worker):
            append_jsonl(args.run, "queue.jsonl",
                         {"event": "claim", "item_id": item_id, "worker": args.worker})
            print(json.dumps({
                "item_id": item_id,
                "title": title,
                "kind": item_kind(args.run, item_id),
                "next_stage": next_stage(args.run, item_id),
            }))
            return
    sys.stderr.write("no claimable items\n")
    sys.exit(4)


# Path fragments that make an item elevated regardless of how it was described.
# Deliberately about WHAT WAS TOUCHED, because a prose description is written by
# the same worker whose claim is being checked.
SENSITIVE_PATH_FRAGMENTS = (
    "bin/",                 # the runtime's own enforcement code
    "hooks/",               # anything the harness executes as a gate
    ".github/workflows/",   # CI, which can deploy
    "settings.json",        # where hooks are registered
    ".env",
    ".pem",
    ".ssh",
    "migrations/",          # schema changes reach prod
)


def sensitive_paths(paths):
    """Which of these paths make the item elevated?"""
    hits = []
    for p in paths:
        norm = p.replace("\\", "/").lower()
        if any(f in norm for f in SENSITIVE_PATH_FRAGMENTS):
            hits.append(p)
    return hits


def uncommitted(paths):
    """Which of these paths still have uncommitted changes?

    Scoped to the paths the worker names, deliberately. A blunt "is the repo
    dirty?" check would block this run because a DIFFERENT session had unrelated
    files open — the multi-session collision this project exists to avoid. Only
    the files this item touched are its business.

    Returns [] when git is unavailable or a path is not in a repo: this is a
    completeness check on the worker's own claim, not a security boundary, and
    it must not block work in a non-git tree.
    """
    import subprocess
    dirty = []
    for p in paths:
        # The pathspec MUST be absolute. git resolves a relative pathspec against
        # its own cwd, and we run it from the file's directory — so a relative
        # path silently matched nothing and every file looked clean.
        ap = os.path.abspath(p)
        try:
            out = subprocess.run(
                ["git", "status", "--porcelain", "--", ap],
                cwd=os.path.dirname(ap) or ".",
                capture_output=True, text=True, timeout=15,
            )
        except Exception:
            return []
        if out.returncode != 0:
            return []
        if out.stdout.strip():
            dirty.append(p)
    return dirty


def cmd_release(args):
    """Hand an item back without completing it.

    A worker that finishes a pipeline STAGE has not finished the ITEM, and until
    now had no way to let go: `done` closes the item, `park` sends it to the
    founder, and nothing else released the lock. The only exit was to wait out
    the two-hour TTL.

    Checks ownership, which `done` and `park` still do not — releasing someone
    else's claim would hand their in-flight item to a second worker.
    """
    read_manifest(args.run)
    path = lock_path(args.run, args.item)
    if not os.path.exists(path):
        sys.stderr.write("item %s is not claimed — nothing to release.\n" % args.item)
        sys.exit(24)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            holder = json.load(fh).get("worker")
    except Exception:
        holder = None
    if holder != args.worker:
        sys.stderr.write(
            "item %s is held by %r, not %r — refusing to release someone else's "
            "claim, which would hand their in-flight work to a second worker.\n"
            % (args.item, holder, args.worker)
        )
        sys.exit(24)
    os.unlink(path)
    append_jsonl(args.run, "queue.jsonl",
                 {"event": "release", "item_id": args.item, "worker": args.worker})


def cmd_done(args):
    read_manifest(args.run)
    entries, bad = read_jsonl_counted(args.run, "journal.jsonl")
    if bad:
        sys.stderr.write(
            "%d unreadable line(s) in journal.jsonl — refusing to mark %s done. "
            "A dropped line may be the CONTRADICTED verdict that should block "
            "this, and counting falsified work as complete is the one outcome "
            "this runtime exists to prevent.\n" % (bad, args.item)
        )
        sys.exit(12)
    verdicts = [e.get("verdict") for e in entries if e.get("item_id") == args.item]
    if not verdicts:
        sys.stderr.write(
            "item %s has no journal entry — refusing to mark it done. Work is "
            "closed out by recording a PROVEN verdict with its evidence, not by "
            "asserting completion. An item id that was never added also lands "
            "here, which is intended.\n" % args.item
        )
        sys.exit(14)
    if verdicts[-1] != "PROVEN":
        sys.stderr.write(
            "item %s has latest verdict %s — refusing to mark it done. Only "
            "PROVEN closes an item; UNPROVEN is the default state of a claim "
            "whose evidence was never shown, and CONTRADICTED means "
            "verification refuted it.\n" % (args.item, verdicts[-1])
        )
        sys.exit(13)
    # Immutable acceptance ledger: an item that declared acceptance criteria
    # cannot be closed until EVERY criterion is verified pass. A PROVEN verdict
    # is the worker's own claim; the criteria are the checklist it may not
    # silently narrow. This is what stops the 3am "declared done on 11 of 12".
    accept = acceptance_state(args.run, args.item)
    unmet = {cid: (txt, res) for cid, (txt, res) in accept.items() if res != "pass"}
    if unmet:
        lines = "\n  ".join("[%s] %s (%s)" % (cid, txt, res or "unverified")
                            for cid, (txt, res) in unmet.items())
        sys.stderr.write(
            "refusing to mark %s done — %d of %d acceptance criteria are not "
            "verified pass:\n  %s\nThe acceptance ledger is append-only; meet or "
            "honestly fail each criterion, never drop one to declare done.\n"
            % (args.item, len(unmet), len(accept), lines)
        )
        sys.exit(18)
    if args.touched:
        dirty = uncommitted(args.touched)
        if dirty:
            sys.stderr.write(
                "refusing to mark %s done — these files still have uncommitted "
                "changes:\n  %s\nA PROVEN verdict on work that never landed is "
                "the false completion this runtime exists to prevent.\n"
                % (args.item, "\n  ".join(dirty))
            )
            sys.exit(17)
        # Tier derived from the files actually touched, not from prose the
        # worker wrote. Two independent verifiers defeated the prose classifier
        # by word choice alone ("edit bin/x" elevated, "update bin/x" routine),
        # and the declared tier was self-reported besides. Paths are observed,
        # so neither phrasing nor mislabelling gets past this.
        sensitive = sensitive_paths(args.touched)
        if sensitive:
            latest = [e for e in entries if e.get("item_id") == args.item][-1]
            if latest.get("tier") != "elevated" or not latest.get("verifier"):
                sys.stderr.write(
                    "refusing to mark %s done — it touched files that make it "
                    "elevated:\n  %s\nbut its latest journal entry declared "
                    "tier=%r with verifier=%r. Elevated work must be re-derived "
                    "from primary sources by a DIFFERENT agent, and the tier is "
                    "taken from what was touched, not from what was claimed.\n"
                    % (args.item, "\n  ".join(sensitive),
                       latest.get("tier"), latest.get("verifier"))
                )
                sys.exit(19)
    append_jsonl(args.run, "queue.jsonl",
                 {"event": "done", "item_id": args.item})
    try:
        os.unlink(lock_path(args.run, args.item))
    except FileNotFoundError:
        pass


def cmd_init(args):
    run_id = uuid.uuid4().hex[:12]
    d = run_dir(run_id)
    os.makedirs(os.path.join(d, "locks"), exist_ok=True)
    manifest = {
        "schema": SCHEMA,
        "run_id": run_id,
        "goal": args.goal,
        "budget_tokens": args.budget,
        "status": "active",
        "created_at": now_ts(),
    }
    atomic_write_json(os.path.join(d, "manifest.json"), manifest)
    for name in ("queue.jsonl", "journal.jsonl", "parked.jsonl", "ledger.jsonl", "acceptance.jsonl"):
        open(os.path.join(d, name), "a", encoding="utf-8").close()
    print(run_id)


def cmd_status(args):
    print(json.dumps(read_manifest(args.run), indent=2))


# Strings that look like a value but assert nothing. A journal entry exists to be
# read later by someone deciding whether to trust the work; "pending" is not a
# verifier and "x" is not evidence.
PLACEHOLDERS = {
    "x", "y", "z", "-", "--", "n/a", "na", "none", "null", "nil", "tbd", "todo",
    "pending", "test", "testing", "temp", "tmp", "foo", "bar", "baz", "asdf",
    "self", "me", "same", "ok", "done", "yes", "no",
}


# Latin lookalikes from other scripts. A worker does not attack itself, so this
# exists for the realistic case — a pasted or autocompleted character that reads
# as "pending" to a human and misses a byte comparison.
CONFUSABLES = str.maketrans({
    "а": "a", "е": "e", "о": "o", "р": "p", "с": "c", "х": "x", "у": "y",
    "і": "i", "ѕ": "s", "ԁ": "d", "ј": "j", "ԛ": "q", "ѡ": "w", "г": "r",
    "α": "a", "ε": "e", "ο": "o", "ρ": "p", "τ": "t", "ι": "i", "κ": "k",
    "μ": "m", "ν": "v", "χ": "x", "υ": "u",
})


def canonical(value):
    """Reduce a value to the letters and digits a reader would actually see.

    `n/a.` and `n / a` and `N.A.` are the same non-answer, and a denylist
    comparing raw bytes catches none of them. This also defeats padding a
    placeholder to clear a length floor: `x . . . . . . . .` canonicalises to
    `x`.
    """
    v = unicodedata.normalize("NFKC", value or "").casefold().translate(CONFUSABLES)
    return re.sub(r"[^0-9a-z]+", "", v)


CANONICAL_PLACEHOLDERS = {canonical(p) for p in PLACEHOLDERS} - {""}

# Prose that asserts a conclusion instead of reporting an observation. Evidence
# is what someone else could re-derive; none of these give them anything to
# re-derive from.
VACUOUS = re.compile(
    r"\b(?:"
    r"i(?:'m| am) (?:confident|certain|sure|positive)"
    r"|it (?:just )?works?(?: fine| well| correctly)?\b"
    r"|works? (?:as (?:intended|expected|advertised)|fine|well|correctly)"
    r"|look(?:s|ed)? (?:good|fine|right|correct|ok)"
    r"|seem(?:s|ed)? (?:to work|fine|good|right|correct|ok)"
    r"|should (?:be fine|work|be ok|be correct)"
    r"|trust me|no issues|all good|nothing broke|everything (?:works|passes)"
    r"|did the work|completed the work|finished it|is done now"
    r"|verified it|confirmed it|checked it out"
    r")\b",
    re.IGNORECASE,
)

# Words that carry no information about what was done. Used only to decide
# whether anything of substance survives once the vacuous phrases are removed.
FILLER = frozenset("""
a an and the this that these those there here it its is are was were be been am
i we my our you your they them so but then than as at by for from in into of on
to with about after before all also just now only really quite very still too
again more most much some any no not yes ok okay fine good great right correct
done thing things stuff everything anything nothing something
""".split())


def content_words(text):
    """The words left once filler is discarded - a rough measure of substance."""
    return [w for w in re.findall(r"[^\W\d_]+", text.lower(), re.UNICODE)
            if w not in FILLER]


def _refuse(field, why, value, tail):
    sys.stderr.write(
        "--%s %s. This is read later by someone deciding whether to trust the "
        "work, and %r does not help them. %s\n" % (field, why, value, tail)
    )
    sys.exit(22)


def reject_thin(field, value, minimum):
    """Refuse a value that is empty, a placeholder, or too short to mean anything.

    Written after I filed an entry with --claim "x" --evidence "x" --verifier
    "pending" one command after building the gate meant to prevent exactly that.
    The runtime accepted it. Discipline that depends on remembering does not
    survive convenience.
    """
    v = (value or "").strip()
    if canonical(v) in CANONICAL_PLACEHOLDERS:
        _refuse(field, "is a placeholder", v,
                "Say what was actually done or seen.")
    if len(v) < minimum:
        _refuse(field, "is too short", v,
                "Give at least %d characters of substance." % minimum)


def reject_vacuous(field, value):
    """Refuse a value that is NOTHING BUT a conclusion.

    The first version searched for a vacuous phrase anywhere and refused on a
    hit. Measured against evidence a competent worker would really write, that
    refused 65% of it: "reran the failing test and nothing broke elsewhere" was
    rejected for its trailing clause even though it opens by naming what was
    run. These phrases are ordinary English tails on a real observation.

    So the test is whether anything survives their removal. If the phrase was
    the whole message, nothing does. Evidence in a language this pattern does
    not match is never refused here, which is the correct direction to fail.
    """
    text = value or ""
    if VACUOUS.search(text) and len(content_words(VACUOUS.sub(" ", text))) < 2:
        _refuse(field, "says only that the work is fine, not what was done", text,
                "Say what you ran, read or changed, and what happened as a result.")


def cmd_journal(args):
    read_manifest(args.run)
    # Verdict first: it is the cheaper, more specific error. Validating the
    # fields first made a bad --verdict report as exit 22, which names the
    # wrong problem.
    if args.verdict not in VERDICTS:
        sys.stderr.write("verdict must be one of %s\n" % (VERDICTS,))
        sys.exit(5)
    reject_thin("claim", args.claim, 15)
    reject_thin("evidence", args.evidence, 25)
    reject_vacuous("claim", args.claim)
    reject_vacuous("evidence", args.evidence)
    if args.verifier is not None:
        reject_thin("verifier", args.verifier, 3)
    if args.supersedes:
        known = {e.get("entry_id") for e in read_jsonl(args.run, "journal.jsonl")
                 if e.get("item_id") == args.item}
        if args.supersedes not in known:
            sys.stderr.write(
                "--supersedes %s is not an entry of item %s. A superseding entry "
                "must be filed under the same item as the claim it overturns, or "
                "the contradiction is never linked and the stale claim is returned "
                "alone.\n" % (args.supersedes, args.item)
            )
            sys.exit(7)
    if args.tier == "elevated" and not args.verifier:
        # Recording a verifier was optional, so elevated work could be closed
        # with nobody named — which is how the very first dogfood run closed
        # four items with zero verifiers recorded. Optional means it happens
        # when convenient, and "convenient" is exactly when it is skipped.
        sys.stderr.write(
            "elevated work requires --verifier. An elevated claim must be "
            "re-derived from primary sources by a DIFFERENT agent than the one "
            "that did the work; naming that agent is what makes the claim "
            "auditable afterwards.\n"
        )
        sys.exit(16)
    if args.verifier:
        # "Verified by a DIFFERENT agent" was previously unauditable — nothing
        # recorded who verified, so the claim could never be checked after the
        # fact. Recording the verifier makes it auditable; refusing a verifier
        # who is also the worker that claimed the item makes it enforced.
        claimers = {e.get("worker") for e in read_jsonl(args.run, "queue.jsonl")
                    if e.get("item_id") == args.item and e.get("event") == "claim"}
        if args.verifier in claimers:
            sys.stderr.write(
                "--verifier %s also claimed item %s. An agent that re-reads its "
                "own work and agrees has verified nothing; an elevated claim must "
                "be re-derived from primary sources by a different agent.\n"
                % (args.verifier, args.item)
            )
            sys.exit(15)
    entry_id = uuid.uuid4().hex[:10]
    append_jsonl(args.run, "journal.jsonl", {
        "entry_id": entry_id,
        "item_id": args.item,
        "claim": args.claim,
        "verdict": args.verdict,
        "evidence": args.evidence,
        "supersedes": args.supersedes,
        "verifier": args.verifier,
        "tier": args.tier,
        "stage": args.stage,
    })
    print(entry_id)


def cmd_history(args):
    read_manifest(args.run)
    all_entries, bad = read_jsonl_counted(args.run, "journal.jsonl")
    entries = [e for e in all_entries if e.get("item_id") == args.item]
    # Attach the reverse link so a superseded claim is never returned alone.
    by_id = {e["entry_id"]: e for e in entries if "entry_id" in e}
    for e in entries:
        target = e.get("supersedes")
        if target and target in by_id:
            by_id[target]["superseded_by"] = e.get("entry_id")
    print(json.dumps(entries, indent=2))
    if bad:
        sys.stderr.write(
            "%d unreadable line(s) in journal.jsonl — a dropped line may be a "
            "SUPERSEDING entry, in which case a contradicted claim above is "
            "shown as if it still stands. Treat this history as unreliable.\n" % bad
        )
        sys.exit(12)


def cmd_park(args):
    read_manifest(args.run)
    # The founder reads these two fields and nothing else when deciding whether
    # to approve. A stand-in here is worse than in the journal: the journal is
    # read after the fact, this is read before a decision.
    #
    # `--action` sits at 8 — LOWER than the journal's `--claim` at 15, which
    # looks inconsistent and is deliberate. The real actions that get parked are
    # short by nature: "git push" is 8, "merge PR #72" is 12. A floor of 10
    # rejected `git push` outright and taught the caller to pad, which is the
    # vacuity this file spends forty lines preventing. `--reason` carries the
    # explanation, and it keeps the higher floor.
    reject_thin("action", args.action, 8)
    reject_thin("reason", args.reason, 25)
    reject_vacuous("action", args.action)
    reject_vacuous("reason", args.reason)
    _, bad_queue = read_jsonl_counted(args.run, "queue.jsonl")
    if bad_queue:
        sys.stderr.write(
            "%d unreadable line(s) in queue.jsonl — refusing to park. A corrupted "
            "'done' line makes a finished item look open, and parking it would "
            "write a false approval request into the founder's list.\n" % bad_queue
        )
        sys.exit(11)
    if args.item not in {i for i, _ in open_items(args.run)}:
        sys.stderr.write(
            "item %s is already terminal (done or parked) — refusing to park it "
            "again. A second park would list the same approval twice for the "
            "founder.\n" % args.item
        )
        sys.exit(8)
    append_jsonl(args.run, "parked.jsonl", {
        "item_id": args.item,
        "action": args.action,
        "reason": args.reason,
    })
    # Mark it terminal in the queue so the run continues past it.
    append_jsonl(args.run, "queue.jsonl", {"event": "done", "item_id": args.item})
    try:
        os.unlink(lock_path(args.run, args.item))
    except FileNotFoundError:
        pass


def parked_state(run_id):
    """Split parked.jsonl into (awaiting, resolved_decisions, bad_line_count).

    A park record has an "action"; a resolution has a "decision" and names the
    item it settles. Without this split the approval list is write-only: it can
    say what needs deciding but never learns what was decided, so handled items
    accumulate in it until nobody trusts the list.

    ORDER decides, not presence. The latest record for an item wins: a park
    filed after a decision puts the item back in front of the founder. That is
    what makes `amend` work without rewriting history — an approval request that
    changed after it was answered has not really been answered.
    """
    records, bad = read_jsonl_counted(run_id, "parked.jsonl")
    last_park, last_decision = {}, {}
    for i, r in enumerate(records):
        iid = r.get("item_id")
        if "action" in r:
            last_park[iid] = (i, r)
        elif "decision" in r:
            last_decision[iid] = (i, r)
    awaiting = [rec for iid, (i, rec) in last_park.items()
                if iid not in last_decision or last_decision[iid][0] < i]
    decisions = {iid: rec for iid, (i, rec) in last_decision.items()
                 if iid in last_park and last_park[iid][0] < i}
    return awaiting, decisions, bad


def cmd_amend(args):
    """Correct a parked approval request that has gone stale.

    Written because one did. An item was parked asking approval to push three
    commits; two more landed while it waited, and nothing could correct the
    text — `park` refused as already-terminal, `resolve` closed it rather than
    changing it, and `claim` would not hand it back. The founder's list could go
    wrong with no way to put it right.

    Amending an already-decided request returns it to `awaiting`. That is the
    founder's call, recorded here: a request whose substance changed after it
    was answered has not been answered.
    """
    read_manifest(args.run)
    reject_thin("action", args.action, 8)
    reject_thin("reason", args.reason, 25)
    reject_vacuous("action", args.action)
    reject_vacuous("reason", args.reason)
    awaiting, decisions, bad = parked_state(args.run)
    if bad:
        sys.stderr.write(
            "%d unreadable line(s) in parked.jsonl — refusing to amend, since "
            "the request being corrected may not be the one you are reading.\n"
            % bad
        )
        sys.exit(10)
    if args.item not in {p.get("item_id") for p in awaiting} | set(decisions):
        sys.stderr.write(
            "item %s was never parked — there is no approval request to amend. "
            "Use `park` to create one.\n" % args.item
        )
        sys.exit(18)
    append_jsonl(args.run, "parked.jsonl", {
        "item_id": args.item,
        "action": args.action,
        "reason": args.reason,
        "amended": True,
    })


def cmd_resolve(args):
    read_manifest(args.run)
    awaiting, decisions, bad = parked_state(args.run)
    if bad:
        sys.stderr.write(
            "%d unreadable line(s) in parked.jsonl — refusing to resolve, the "
            "list of what is actually awaiting you cannot be trusted.\n" % bad
        )
        sys.exit(10)
    if args.item in decisions:
        sys.stderr.write(
            "item %s was already resolved as %s — refusing to resolve it twice.\n"
            % (args.item, decisions[args.item].get("decision"))
        )
        sys.exit(18)
    if args.item not in {p.get("item_id") for p in awaiting}:
        sys.stderr.write(
            "item %s is not awaiting a decision — only a parked item can be "
            "resolved.\n" % args.item
        )
        sys.exit(18)
    append_jsonl(args.run, "parked.jsonl", {
        "item_id": args.item,
        "decision": args.decision,
        "note": args.note,
    })


def cmd_parked(args):
    read_manifest(args.run)
    awaiting, decisions, bad = parked_state(args.run)
    for p in awaiting:
        p["status"] = "awaiting"
    parks_by_id = {p.get("item_id"): p for p in
                   [r for r in read_jsonl(args.run, "parked.jsonl") if "action" in r]}
    settled = []
    for iid, d in decisions.items():
        orig = parks_by_id.get(iid, {})
        # Keep what it was ABOUT, not just what was decided — a decision
        # with no action is unreadable a week later.
        settled.append({"item_id": iid, "status": "resolved",
                        "action": orig.get("action"), "reason": orig.get("reason"),
                        "decision": d.get("decision"), "note": d.get("note")})
    records = awaiting + settled
    print(json.dumps(records, indent=2))
    if bad:
        sys.stderr.write(
            "%d unreadable line(s) in parked.jsonl — this list may be MISSING "
            "approvals the founder needs to see. Treat it as incomplete.\n" % bad
        )
        sys.exit(10)


def budget_state(run_id):
    m = read_manifest(run_id)
    spent = 0
    unreadable = 0
    path = os.path.join(run_dir(run_id), "ledger.jsonl")
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    spent += int(json.loads(line).get("tokens", 0))
                except (ValueError, TypeError, AttributeError):
                    unreadable += 1
    else:
        # init always creates ledger.jsonl, so its absence is anomalous, not
        # a run that has spent nothing. Treat it the same as one unreadable
        # line so a deleted ledger cannot reopen a ceiling already crossed.
        unreadable += 1
    budget = int(m["budget_tokens"])
    return {
        "spent": spent,
        "budget": budget,
        "remaining": max(0, budget - spent),
        # Fail closed: if any line is unreadable we cannot know true spend, and
        # under-counting would breach the ceiling silently. Overspending cannot
        # be undone; a paused run can be resumed.
        "exhausted": spent >= budget or unreadable > 0,
        "ledger_unreadable_lines": unreadable,
    }


def cmd_budget_record(args):
    read_manifest(args.run)
    if args.tokens < 0:
        sys.stderr.write(
            "--tokens must not be negative (got %d). A negative record would "
            "deflate spend and reopen a ceiling that had already been reached.\n"
            % args.tokens
        )
        sys.exit(9)
    append_jsonl(args.run, "ledger.jsonl", {
        "agent": args.agent, "phase": args.phase, "tokens": args.tokens,
    })


def cmd_budget_check(args):
    state = budget_state(args.run)
    print(json.dumps(state, indent=2))
    sys.exit(6 if state["exhausted"] else 0)


def acceptance_state(run_id, item_id):
    """Latest result per acceptance criterion for an item.

    Returns {criterion_id: (text, latest_result_or_None)}. Criteria are
    append-only: `criterion` adds one, `criterion-verify` records pass/fail,
    and there is deliberately no delete — a worker cannot prune an unmet
    criterion to declare the item done. This is the immutable requirements
    ledger from Anthropic's long-horizon-harness recipe: the acceptance list
    the agent may extend and verify but never shrink.
    """
    text = {}
    result = {}
    for rec in read_jsonl(run_id, "acceptance.jsonl"):
        if rec.get("item_id") != item_id:
            continue
        cid = rec.get("criterion_id")
        if rec.get("event") == "criterion":
            text[cid] = rec.get("text", "")
        elif rec.get("event") == "verify":
            result[cid] = rec.get("result")
    return {cid: (text[cid], result.get(cid)) for cid in text}


def cmd_criterion(args):
    """Add an acceptance criterion to an item (append-only, never removable)."""
    read_manifest(args.run)
    cid = uuid.uuid4().hex[:8]
    append_jsonl(args.run, "acceptance.jsonl",
                 {"event": "criterion", "item_id": args.item, "criterion_id": cid,
                  "text": args.text})
    print(cid)


def cmd_criterion_verify(args):
    """Record pass/fail for one acceptance criterion, with evidence."""
    read_manifest(args.run)
    if args.result not in ("pass", "fail"):
        sys.stderr.write("result must be pass or fail\n")
        sys.exit(5)
    append_jsonl(args.run, "acceptance.jsonl",
                 {"event": "verify", "item_id": args.item, "criterion_id": args.criterion,
                  "result": args.result, "evidence": args.evidence})
    print("%s: %s" % (args.criterion, args.result))


def cmd_skip(args):
    """Manually step over a poison item (the convoy continues without it).

    A terminal event like `done`, but it records that the item was NOT
    completed and why — so a skipped unit is visible in the report, never
    silently dropped or silently retried.
    """
    read_manifest(args.run)
    append_jsonl(args.run, "queue.jsonl",
                 {"event": "skip", "item_id": args.item, "reason": args.reason})
    append_jsonl(args.run, "journal.jsonl",
                 {"event": "skip", "item_id": args.item, "reason": args.reason})
    print("skipped %s: %s" % (args.item, args.reason))


def cmd_stop(args):
    m = read_manifest(args.run)
    remaining = [{"item_id": i, "title": t} for i, t in open_items(args.run)]
    resume = {
        "stopped_at": now_ts(),
        "stopped_because": args.why,
        "open_items": remaining,
        "budget": budget_state(args.run),
    }
    atomic_write_json(os.path.join(run_dir(args.run), "resume.json"), resume)
    m["status"] = "stopped"
    m["stopped_because"] = args.why
    atomic_write_json(os.path.join(run_dir(args.run), "manifest.json"), m)


def cmd_report(args):
    m = read_manifest(args.run)
    queue_records, bad_queue = read_jsonl_counted(args.run, "queue.jsonl")
    done_ids = {r.get("item_id") for r in queue_records if r.get("event") == "done"}
    skipped_ids = {r.get("item_id") for r in queue_records if r.get("event") == "skip"}
    awaiting_recs, decisions, bad_parked = parked_state(args.run)
    # Every item that was ever parked stays out of `completed` — parking wrote a
    # queue `done` event, and a resolved approval is still not work this run did.
    parked_ids = {p.get("item_id") for p in awaiting_recs} | set(decisions)
    awaiting_ids = {p.get("item_id") for p in awaiting_recs}
    b = budget_state(args.run)
    print(json.dumps({
        "run_id": m["run_id"],
        "status": m["status"],
        "stopped_because": m.get("stopped_because"),
        "completed": len(done_ids - parked_ids),
        "parked": len(awaiting_ids),
        "parked_resolved": len(decisions),
        "skipped": len(skipped_ids),
        "open": len(open_items(args.run)),
        "spent": b["spent"],
        "budget": b["budget"],
        "exhausted": b["exhausted"],
        "ledger_unreadable_lines": b["ledger_unreadable_lines"],
    }, indent=2))
    if bad_queue or bad_parked:
        sys.stderr.write(
            "%d unreadable line(s) in queue.jsonl, %d in parked.jsonl — this "
            "report may be wrong: a dropped 'done' or park line can reclassify "
            "a founder approval as completed work. Treat these numbers as "
            "unreliable.\n" % (bad_queue, bad_parked)
        )
        sys.exit(10)


def main():
    p = argparse.ArgumentParser(prog="gstack-run")
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("init")
    pi.add_argument("--goal", required=True)
    pi.add_argument("--budget", type=int, required=True)
    pi.set_defaults(func=cmd_init)

    ps = sub.add_parser("status")
    ps.add_argument("--run", required=True)
    ps.set_defaults(func=cmd_status)

    pa = sub.add_parser("add")
    pa.add_argument("--run", required=True)
    pa.add_argument("--title", required=True)
    pa.add_argument("--kind", default=None,
                    help="selects the pipeline; see gstack-pipeline --kinds")
    pa.set_defaults(func=cmd_add)

    pc = sub.add_parser("claim")
    pc.add_argument("--run", required=True)
    pc.add_argument("--worker", required=True)
    pc.set_defaults(func=cmd_claim)

    prl = sub.add_parser("release")
    prl.add_argument("--run", required=True)
    prl.add_argument("--item", required=True)
    prl.add_argument("--worker", required=True)
    prl.set_defaults(func=cmd_release)

    pd = sub.add_parser("done")
    pd.add_argument("--run", required=True)
    pd.add_argument("--item", required=True)
    pd.add_argument("--touched", action="append", default=None,
                    help="a file this item changed; repeatable. done refuses "
                         "if any still has uncommitted changes")
    pd.set_defaults(func=cmd_done)

    pk = sub.add_parser("skip")
    pk.add_argument("--run", required=True)
    pk.add_argument("--item", required=True)
    pk.add_argument("--reason", required=True)
    pk.set_defaults(func=cmd_skip)

    pcr = sub.add_parser("criterion")
    pcr.add_argument("--run", required=True)
    pcr.add_argument("--item", required=True)
    pcr.add_argument("--text", required=True)
    pcr.set_defaults(func=cmd_criterion)

    pcv = sub.add_parser("criterion-verify")
    pcv.add_argument("--run", required=True)
    pcv.add_argument("--item", required=True)
    pcv.add_argument("--criterion", required=True)
    pcv.add_argument("--result", required=True, choices=["pass", "fail"])
    pcv.add_argument("--evidence", default="")
    pcv.set_defaults(func=cmd_criterion_verify)

    pj = sub.add_parser("journal")
    pj.add_argument("--run", required=True)
    pj.add_argument("--item", required=True)
    pj.add_argument("--claim", required=True)
    pj.add_argument("--verdict", required=True)
    pj.add_argument("--evidence", required=True)
    pj.add_argument("--supersedes", default=None)
    pj.add_argument("--verifier", default=None,
                    help="agent that verified this claim; refused if it also "
                         "claimed the item")
    pj.add_argument("--stage", default=None,
                    help="pipeline stage this entry closes")
    pj.add_argument("--tier", default=None, choices=["routine", "elevated"],
                    help="verification tier from gstack-risk-classify; "
                         "elevated requires --verifier")
    pj.set_defaults(func=cmd_journal)

    ph = sub.add_parser("history")
    ph.add_argument("--run", required=True)
    ph.add_argument("--item", required=True)
    ph.set_defaults(func=cmd_history)

    pp = sub.add_parser("park")
    pp.add_argument("--run", required=True)
    pp.add_argument("--item", required=True)
    pp.add_argument("--action", required=True)
    pp.add_argument("--reason", required=True)
    pp.set_defaults(func=cmd_park)

    am = sub.add_parser("amend")
    am.add_argument("--run", required=True)
    am.add_argument("--item", required=True)
    am.add_argument("--action", required=True)
    am.add_argument("--reason", required=True)
    am.set_defaults(func=cmd_amend)

    prs = sub.add_parser("resolve")
    prs.add_argument("--run", required=True)
    prs.add_argument("--item", required=True)
    prs.add_argument("--decision", required=True,
                     choices=["approved", "declined"])
    prs.add_argument("--note", default=None)
    prs.set_defaults(func=cmd_resolve)

    pl = sub.add_parser("parked")
    pl.add_argument("--run", required=True)
    pl.set_defaults(func=cmd_parked)

    pbr = sub.add_parser("budget-record")
    pbr.add_argument("--run", required=True)
    pbr.add_argument("--agent", required=True)
    pbr.add_argument("--phase", required=True)
    pbr.add_argument("--tokens", type=int, required=True)
    pbr.set_defaults(func=cmd_budget_record)

    pbc = sub.add_parser("budget-check")
    pbc.add_argument("--run", required=True)
    pbc.set_defaults(func=cmd_budget_check)

    pst = sub.add_parser("stop")
    pst.add_argument("--run", required=True)
    pst.add_argument("--why", required=True,
                     choices=["queue-drained", "budget-exhausted", "breaker-tripped"])
    pst.set_defaults(func=cmd_stop)

    prp = sub.add_parser("report")
    prp.add_argument("--run", required=True)
    prp.set_defaults(func=cmd_report)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

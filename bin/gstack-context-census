#!/usr/bin/env python3
"""gstack-context-census — where a session's context actually went.

Written after a spec proposed optimising a number that never enters a context
window. The suite is ~880,000 tokens on disk and none of it loads at once;
measuring a real session showed tool calls at 42% and tool results at 25%, with
skill loading inside the remaining 19%.

Attribution before optimisation. This reports what a session was made of so the
next diet targets the largest consumer instead of the most alarming number.

Tokens are estimated at 4 characters each. That is a rough constant, and it is
labelled as an estimate in the output rather than presented as a measurement.

Usage:
    gstack-context-census --transcript ~/.claude/projects/<proj>/<id>.jsonl
    gstack-context-census --transcript <path> --top 5

Exit codes:
    0  ok
    2  no such transcript
    3  nothing attributable in the file
"""
import argparse
import re
import json
import os
import sys

CHARS_PER_TOKEN = 4


def add(bucket, key, chars):
    bucket[key] = bucket.get(key, 0) + chars


def census(path, keep_offenders=0):
    """Totals by consumer and tool, plus the largest individual items.

    Totals say WHERE context goes; offenders say WHICH call did it. "Bash is
    14% of the session" is not actionable — "this one command returned 40,000
    tokens" is, because it names something to change.
    """
    by_consumer, by_tool, unreadable = {}, {}, 0
    calls_by_tool = {}
    result_count = 0
    offenders = []
    pending = {}
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                unreadable += 1
                continue
            if not isinstance(row, dict):
                unreadable += 1
                continue
            role = row.get("type", "?")
            content = (row.get("message") or {}).get("content")
            if isinstance(content, str):
                add(by_consumer, "%s text" % role, len(content))
                continue
            if not isinstance(content, list):
                continue
            for block in content:
                if not isinstance(block, dict):
                    continue
                kind = block.get("type")
                if kind == "text":
                    add(by_consumer, "%s text" % role, len(block.get("text") or ""))
                elif kind == "thinking":
                    add(by_consumer, "thinking", len(block.get("thinking") or ""))
                elif kind == "tool_use":
                    n = len(json.dumps(block.get("input") or {}))
                    name = block.get("name") or "(unnamed)"
                    add(by_consumer, "tool calls", n)
                    add(by_tool, name, n)
                    add(calls_by_tool, name, 1)
                    if keep_offenders and block.get("id"):
                        # Remember the call so its RESULT can be attributed to
                        # a tool and a command, not just to "tool results".
                        inp = block.get("input") or {}
                        gist = (inp.get("command") or inp.get("file_path")
                                or inp.get("pattern") or inp.get("description")
                                or "")
                        pending[block["id"]] = (name, " ".join(str(gist).split())[:120])
                elif kind == "tool_result":
                    body = block.get("content")
                    n = len(body if isinstance(body, str) else json.dumps(body))
                    add(by_consumer, "tool results", n)
                    result_count += 1
                    if keep_offenders:
                        name, gist = pending.pop(
                            block.get("tool_use_id"), ("(unmatched)", ""))
                        offenders.append((n, name, gist))
    offenders.sort(reverse=True)
    return (by_consumer, by_tool, unreadable, offenders[:keep_offenders],
            calls_by_tool, result_count)


def tool_signature(block):
    """A coarse identity for a tool call, for chain mining.

    Bash is signed by the command's leading token (git, grep, python, ...) so
    'git status' and 'git log' both read as `Bash:git` — a run of them is the
    collapsible chain. Other tools sign by name alone.
    """
    name = block.get("name") or "(unnamed)"
    if name == "Bash":
        cmd = str((block.get("input") or {}).get("command") or "").strip()
        # Take the LAST segment after a leading cd/export chain, so
        # `cd "…/TaskMaster" && git status` signs as git, not the cd path.
        seg = cmd
        for m in re.split(r"&&|\|\||;", cmd):
            m = m.strip()
            if not m:
                continue
            first = m.split()[0] if m.split() else ""
            base = os.path.basename(first.strip("\"'"))
            if base in ("cd", "export", "set") or "=" in first:
                continue
            seg = m
            break
        toks = seg.split()
        head = os.path.basename(toks[0].strip("\"'")) if toks else "?"
        return "Bash:%s" % (head or "?")
    return name


def mine_chains(path, n=2):
    """Count repeated adjacent tool-call n-grams within a session.

    A chain that recurs is a candidate for collapse into one script/batch —
    each repeat is (n-1) round trips at a ~1s floor that a single call removes.
    Only ADJACENT calls with nothing but more tool calls between them count:
    an assistant text/thinking block between two calls means a decision was
    made, so they are not blindly collapsible.
    """
    import collections
    seq = []
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if not isinstance(row, dict):
                continue
            content = (row.get("message") or {}).get("content")
            if isinstance(content, str) and content.strip():
                seq.append(None)  # assistant text = a decision boundary
                continue
            if not isinstance(content, list):
                continue
            for block in content:
                if not isinstance(block, dict):
                    continue
                k = block.get("type")
                if k == "tool_use":
                    seq.append(tool_signature(block))
                elif k in ("text", "thinking") and (block.get("text") or block.get("thinking")):
                    seq.append(None)  # boundary
    grams = collections.Counter()
    run = []
    for s in seq:
        if s is None:
            run = []
            continue
        run.append(s)
        if len(run) >= n:
            grams[tuple(run[-n:])] += 1
    return grams


def main():
    ap = argparse.ArgumentParser(prog="gstack-context-census")
    ap.add_argument("--transcript", required=True)
    ap.add_argument("--offenders", type=int, default=0,
                    help="also report the N largest individual tool results")
    ap.add_argument("--top", type=int, default=0,
                    help="limit the by_tool breakdown to the N largest")
    ap.add_argument("--chains", type=int, default=0, metavar="N",
                    help="mine repeated adjacent tool-call chains of length N "
                         "(collapse candidates); prints the most frequent")
    args = ap.parse_args()

    if args.chains:
        if not os.path.isfile(args.transcript):
            sys.stderr.write("no such transcript: %s\n" % args.transcript)
            sys.exit(2)
        grams = mine_chains(args.transcript, n=args.chains)
        repeated = [(c, g) for g, c in grams.items() if c >= 2]
        repeated.sort(reverse=True)
        if not repeated:
            print("no chain of length %d recurs — nothing obvious to collapse." % args.chains)
            sys.exit(0)
        print("Repeated tool-call chains (length %d) — each is a collapse candidate." % args.chains)
        print("A chain seen K times costs (K x (%d-1)) round trips a single call would save.\n" % args.chains)
        for count, gram in repeated[:15]:
            saved = count * (args.chains - 1)
            print("  %3dx  %s   (~%d round trips if collapsed)" % (count, " -> ".join(gram), saved))
        sys.exit(0)

    if not os.path.isfile(args.transcript):
        sys.stderr.write("no such transcript: %s\n" % args.transcript)
        sys.exit(2)

    (by_consumer, by_tool, unreadable, offenders,
     calls_by_tool, result_count) = census(
        args.transcript, keep_offenders=args.offenders)
    if not by_consumer:
        sys.stderr.write(
            "nothing attributable in %s — %d unreadable line(s). A census over a "
            "file it cannot parse would report zeros that look like a finding.\n"
            % (args.transcript, unreadable))
        sys.exit(3)

    to_tokens = lambda d: {k: v // CHARS_PER_TOKEN for k, v in d.items()}
    tools = sorted(by_tool.items(), key=lambda kv: -kv[1])
    if args.top:
        tools = tools[:args.top]
    print(json.dumps({
        "transcript": args.transcript,
        "total_tokens": sum(by_consumer.values()) // CHARS_PER_TOKEN,
        "by_consumer": to_tokens(by_consumer),
        "by_tool": to_tokens(dict(tools)),
        "unreadable_lines": unreadable,
        # Round trips, not output size, turned out to be the cost. A session
        # measured here spent 39% of its context on 1,011 Bash calls and 1,798
        # results whose MEDIAN was 58 tokens — there is no large output to trim,
        # only a large number of exchanges.
        "round_trips": {
            "tool_calls": sum(calls_by_tool.values()),
            "tool_results": result_count,
            "calls_by_tool": dict(sorted(calls_by_tool.items(),
                                         key=lambda kv: -kv[1])),
        },
        "unreadable_lines_note": "counted, never skipped silently",
        "largest_results": [
            {"tokens": n // CHARS_PER_TOKEN, "tool": name, "what": gist}
            for n, name, gist in offenders
        ],
        "estimated": "Tokens are estimated at %d characters each, not counted by "
                     "a tokeniser." % CHARS_PER_TOKEN,
    }, indent=2))


if __name__ == "__main__":
    main()

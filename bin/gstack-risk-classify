#!/usr/bin/env python3
"""gstack-risk-classify — assigns an action a verification tier.

Returns "elevated" for actions where being wrong is expensive, "routine"
otherwise. Elevated claims get re-derived by a DIFFERENT agent from primary
sources; routine claims need only typecheck and tests.

This is a LOOKUP TABLE on purpose. Model judgment about risk is precisely what
failed on 2026-08-06 — every wrong claim felt correct when it was made. Keep it
dumb, readable and testable; extend the list rather than adding cleverness.

Usage:
    gstack-risk-classify --action "<command or description>"
    gstack-risk-classify --action "..." --model    # the model a dispatched
                                                    # agent for this tier gets

--model prints which model to hand a subagent dispatched for this action.
Elevated work is verified by a DIFFERENT agent re-deriving from primary
sources, and that verifier gates an irreversible action, so it gets the
frontier model. Routine work's checks are typecheck and tests; a subagent
dispatched for it (exploration, a scout, a summary) does not need frontier
capacity. Same table, one more column — the tier already encodes the risk,
so the model choice is not a second judgement call.
"""
import argparse

MODEL_FOR_TIER = {
    "elevated": "opus",
    "routine": "sonnet",
}

ELEVATED_PATTERNS = [
    "git push",
    "force-push",
    "--force",
    "db-migrate",
    "mode=apply",
    "drop table",
    "delete from",
    "truncate",
    "rm -rf",
    "settings.json",
    "prod",
    "deploy",
    "gcloud run",
    "fly deploy",
    "send",
    "email",
    "secret",
    "credential",
    "gcloud ",
    ".env",
    ".pem",
    ".ssh",
    "workflows/",
    "sudo ",
    "publish",
    # Changes to the runtime's OWN enforcement code. Being wrong here means
    # unverified work gets closed out — the failure this whole system exists to
    # prevent — yet the table rated it routine, because it matches on the shape
    # of a command rather than on what a change MEANS.
    "edit bin/",
    "modify bin/",
    "update bin/",
    "patch bin/",
    "rewrite bin/",
    "refactor bin/",
    "change bin/",
    "budget-guard",
    "generated-guard",
    "risk-classify",
]


def classify(action):
    low = action.lower()
    return "elevated" if any(p in low for p in ELEVATED_PATTERNS) else "routine"


def model_for(action):
    return MODEL_FOR_TIER[classify(action)]


def main():
    p = argparse.ArgumentParser(prog="gstack-risk-classify")
    p.add_argument("--action", required=True)
    p.add_argument("--model", action="store_true",
                   help="print the model a dispatched agent for this tier gets, "
                        "instead of the tier")
    args = p.parse_args()
    print(model_for(args.action) if args.model else classify(args.action))


if __name__ == "__main__":
    main()

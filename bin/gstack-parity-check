#!/usr/bin/env python3
"""gstack-parity-check — did the repo edit actually reach the copy a user runs?

The live skills at ~/.claude/skills/<name>/SKILL.md are COPIES of the repo's
<repo>/<name>/SKILL.md. A correct repo edit changes nothing until someone
copies it. On 2026-09-12 that happened three times in one session: skill
edits before install, a hook before registration, and a routing fix merged to
main while all 54 live copies still carried the old text.

A carved skill is more than its SKILL.md: the skeleton tells the model to
"Read sections/<name>.md", and those files are copied next to the live
SKILL.md by ./setup. So the unit of parity is SKILL.md plus the sections/
directory when the repo skill has one. On 2026-09-13 the skill-start absorb
carved 20 skills, /parity reported 56 IDENTICAL, and every one of the 20 live
copies pointed at a sections/ directory that did not exist yet.

This is the /parity skill's checker, promoted from a heredoc the skill wrote
to $TEMP into a real script, so it can run as a SessionStart hook and so the
skill and the hook cannot drift apart.

Usage:
    gstack-parity-check            # full report, exits 0
    gstack-parity-check --hook     # prints ONLY when something drifted; exits 0
    gstack-parity-check --sync     # copy repo -> live for DRIFTED and REPO-ONLY

Sync is one-directional and never copies live back to the repo: a live-side
hand-edit landing in version control would be committed as if it were
reviewed source. It refuses when the repo working tree is dirty for a file it
would copy.

The router skill (repo-root SKILL.md, name: gstack) is out of scope: its repo
file IS where the loader reads it, so there is no separate live copy.
"""
import hashlib
import os
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(os.environ.get("GSTACK_REPO") or Path(__file__).resolve().parent.parent)
LIVE = Path(os.environ.get("GSTACK_LIVE_SKILLS") or os.path.expanduser("~/.claude/skills"))


def sha256(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()


def unit_files(skill_dir):
    """Every file that makes up one skill's live unit: SKILL.md plus sections/**.

    Returned as {relative posix path: Path}; a skill without a sections/
    directory is just its SKILL.md.
    """
    files = {"SKILL.md": skill_dir / "SKILL.md"}
    sections = skill_dir / "sections"
    if sections.is_dir():
        for p in sorted(sections.rglob("*")):
            if p.is_file():
                files[p.relative_to(skill_dir).as_posix()] = p
    return files


def unit_hash(files):
    h = hashlib.sha256()
    for rel in sorted(files):
        h.update(rel.encode("utf-8"))
        h.update(b"\0")
        h.update(sha256(files[rel]).encode("ascii"))
        h.update(b"\n")
    return h.hexdigest()


def skills_under(root, exclude=()):
    found = {}
    if not root.is_dir():
        return found
    for d in sorted(root.iterdir()):
        if not d.is_dir() or d.name.startswith(".") or d.name in exclude:
            continue
        if (d / "SKILL.md").is_file():
            found[d.name] = d
    return found


def drift_parts(repo_files, live_files):
    """Which part of the unit differs: 'SKILL.md', 'sections', or both."""
    parts = []
    if sha256(repo_files["SKILL.md"]) != sha256(live_files["SKILL.md"]):
        parts.append("SKILL.md")
    rs = {k: v for k, v in repo_files.items() if k != "SKILL.md"}
    ls = {k: v for k, v in live_files.items() if k != "SKILL.md"}
    if set(rs) != set(ls) or any(sha256(rs[k]) != sha256(ls[k]) for k in rs):
        parts.append("sections")
    return "+".join(parts)


def compare():
    repo = skills_under(REPO)
    live = skills_under(LIVE, exclude=(REPO.name,))
    identical, drifted, repo_only = [], [], []
    for name, rd in repo.items():
        ld = live.get(name)
        if ld is None:
            repo_only.append(name)
            continue
        rf, lf = unit_files(rd), unit_files(ld)
        if unit_hash(rf) == unit_hash(lf):
            identical.append(name)
        else:
            r_mtime = max(p.stat().st_mtime for p in rf.values())
            l_mtime = max(p.stat().st_mtime for p in lf.values())
            newer = "repo" if r_mtime > l_mtime else "live"
            drifted.append((name, newer, drift_parts(rf, lf)))
    live_only = [n for n in live if n not in repo]
    return repo, identical, drifted, repo_only, live_only


def report(identical, drifted, repo_only, live_only):
    print("IDENTICAL: %d" % len(identical))
    print("DRIFTED: %d" % len(drifted))
    for n, newer, part in drifted:
        print("  %s -- %s is newer (%s)" % (n, newer, part))
    print("REPO-ONLY: %d  (invisible to the user until synced)" % len(repo_only))
    for n in repo_only:
        print("  %s -- invisible to the user" % n)
    print("LIVE-ONLY: %d  (informational -- not necessarily an error)" % len(live_only))
    for n in live_only:
        print("  %s" % n)


def hook(drifted, repo_only):
    """Session-start form: silent when clean, one block when not, always exit 0.

    A hook that fails the session over a stale copy would block the user from
    the very session they might use to fix it. Observers fail open.
    """
    if not drifted and not repo_only:
        return 0
    print("gstack parity: %d skill(s) differ between repo and live copy"
          % (len(drifted) + len(repo_only)))
    for n, newer, part in drifted[:8]:
        print("  %s (%s is newer, %s)" % (n, newer, part))
    for n in repo_only[:8]:
        print("  %s (repo only)" % n)
    rest = len(drifted) + len(repo_only) - min(8, len(drifted)) - min(8, len(repo_only))
    if rest > 0:
        print("  ... and %d more" % rest)
    print("  run: gstack-parity-check --sync")
    return 0


def copy_unit(repo_dir, live_dir):
    """Mirror repo -> live: SKILL.md, and sections/ replaced wholesale (what ./setup does)."""
    live_dir.mkdir(parents=True, exist_ok=True)
    (live_dir / "SKILL.md").write_bytes((repo_dir / "SKILL.md").read_bytes())
    live_sections = live_dir / "sections"
    if live_sections.is_dir() or live_sections.is_symlink():
        shutil.rmtree(live_sections)
    if (repo_dir / "sections").is_dir():
        shutil.copytree(repo_dir / "sections", live_sections)


def sync(repo, identical, drifted, repo_only):
    to_copy = [n for n, _, _ in drifted] + repo_only
    if not to_copy:
        print("\nSYNC: nothing to do, already IDENTICAL/none REPO-ONLY.")
        return 0
    rel = []
    for n in to_copy:
        rel.append("%s/SKILL.md" % n)
        if (repo[n] / "sections").is_dir():
            rel.append("%s/sections" % n)
    dirty = subprocess.run(["git", "-C", str(REPO), "status", "--porcelain", "--"] + rel,
                           capture_output=True, text=True).stdout.strip()
    if dirty:
        print("\nSYNC REFUSED: repo working tree is dirty for files it would copy:")
        print(dirty)
        print("Commit or stash the repo changes first, then re-run --sync.")
        return 1
    print("\nSYNCING %d skill(s), repo -> live only:" % len(to_copy))
    for name in to_copy:
        copy_unit(repo[name], LIVE / name)
        print("  copied %s%s" % (name, " (+sections)" if (repo[name] / "sections").is_dir() else ""))
    still = [n for n in to_copy
             if unit_hash(unit_files(repo[n])) != unit_hash(unit_files(LIVE / n))]
    print("\n--- post-sync ---")
    print("IDENTICAL: %d" % (len(identical) + len(to_copy) - len(still)))
    print("DRIFTED: %d" % len(still))
    for n in still:
        print("  %s -- STILL DRIFTED, copy did not take (permissions? locked file?)" % n)
    return 1 if still else 0


def main(argv):
    repo, identical, drifted, repo_only, live_only = compare()
    if "--hook" in argv:
        return hook(drifted, repo_only)
    report(identical, drifted, repo_only, live_only)
    if "--sync" in argv:
        return sync(repo, identical, drifted, repo_only)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:  # a checker must never take the session down
        if "--hook" in sys.argv:
            sys.exit(0)
        sys.stderr.write("gstack-parity-check: %s\n" % exc)
        sys.exit(2)
